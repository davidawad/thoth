{
  "name": "thoth",
  "version": "1.1.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "fuzz:epub": "NODE_OPTIONS=--experimental-strip-types jazzer fuzz/epub-extract-text.fuzz.js -- -max_total_time=30",
    "fuzz:pdf": "NODE_OPTIONS=--experimental-strip-types jazzer fuzz/pdf-document-parse.fuzz.js --disableBugDetectors=prototype-pollution -- -max_total_time=30",
    "bench": "vitest bench --run --compare=bench/baseline.json",
    "bench:update": "vitest bench --run --outputJson=bench/baseline.json",
    "commitlint": "commitlint --edit",
    "release": "semantic-release",
    "dockerbuild": "bash dockerbuild.sh",
    "postinstall": "cp node_modules/pdfjs-dist/build/pdf.worker.min.js public/pdf.worker.min.js"
  },
  "dependencies": {
    "@babel/core": "7.26.9",
    "@tailwindcss/postcss": "^4.0.7",
    "automated-readability": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "babel-loader": "9.2.1",
    "babel-plugin-named-asset-import": "^0.3.2",
    "babel-preset-react-app": "^10.1.0",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "coleman-liau": "^2.0.1",
    "compromise": "^14.14.4",
    "css-loader": "7.1.2",
    "daisyui": "^5.7.4",
    "dale-chall": "^2.0.1",
    "dale-chall-formula": "^2.0.1",
    "dotenv": "^16.4.7",
    "dotenv-expand": "12.0.1",
    "draft-js": "^0.11.7",
    "effect": "^3.22.0",
    "epubjs": "^0.3.84",
    "eslint": "^9.20.1",
    "eslint-loader": "4.0.2",
    "file-loader": "6.2.0",
    "flesch": "^2.0.1",
    "fs-extra": "11.3.0",
    "gunning-fog": "^2.0.1",
    "html-webpack-plugin": "5.6.3",
    "is-wsl": "^3.1.0",
    "lint-staged": "^15.4.3",
    "mini-css-extract-plugin": "2.9.2",
    "next": "^15.1.7",
    "optimize-css-assets-webpack-plugin": "6.0.1",
    "pdfjs-dist": "3.11.174",
    "pnp-webpack-plugin": "1.7.0",
    "postcss": "^8.5.2",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-loader": "8.1.1",
    "postcss-normalize": "13.0.1",
    "postcss-preset-env": "^10.1.4",
    "postcss-safe-parser": "7.0.1",
    "prop-types": "^15.7.2",
    "react": "^19.0.0",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-ga": "^3.3.1",
    "react-modal": "^3.16.3",
    "react-top-loading-bar": "^3.0.2",
    "resolve": "1.22.10",
    "sass-loader": "^16.0.5",
    "smog-formula": "^2.0.1",
    "spache": "^2.0.1",
    "spache-formula": "^2.0.1",
    "style-loader": "4.0.0",
    "styled-components": "^6.1.15",
    "syllable": "^5.0.1",
    "tailwindcss": "^4.0.7",
    "terser-webpack-plugin": "5.3.11",
    "ts-pnp": "1.2.0",
    "unlerp": "^1.0.1",
    "url-loader": "4.1.1",
    "webpack": "5.98.0",
    "webpack-dev-server": "5.2.0",
    "webpack-manifest-plugin": "5.0.0",
    "workbox-webpack-plugin": "7.3.0",
    "worker-loader": "^3.0.8",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --single-quote --write",
      "git add"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@jazzer.js/core": "^4.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/draft-js": "^0.11.20",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-ga": "^2.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/syllable": "^5.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "cssnano": "^7.0.6",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "tinybench": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "canvas"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
