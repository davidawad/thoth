{
  "name": "thoth",
  "version": "0.1.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "ci": "echo \"CI/CD if we had it but this is a hobby project\"",
    "dockerbuild": "bash dockerbuild.sh",
    "postinstall": "cp node_modules/pdfjs-dist/build/pdf.worker.min.js public/pdf.worker.min.js"
  },
  "dependencies": {
    "@babel/core": "7.26.9",
    "@tailwindcss/postcss": "^4.0.7",
    "automated-readability": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "babel-loader": "9.2.1",
    "babel-plugin-named-asset-import": "^0.3.2",
    "babel-preset-react-app": "^10.1.0",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "coleman-liau": "^2.0.1",
    "compromise": "^14.14.4",
    "css-loader": "7.1.2",
    "daisyui": "^5.7.4",
    "dale-chall": "^2.0.1",
    "dale-chall-formula": "^2.0.1",
    "dotenv": "^16.4.7",
    "dotenv-expand": "12.0.1",
    "draft-js": "^0.11.7",
    "epubjs": "^0.3.84",
    "eslint": "^9.20.1",
    "eslint-loader": "4.0.2",
    "file-loader": "6.2.0",
    "flesch": "^2.0.1",
    "fs-extra": "11.3.0",
    "gunning-fog": "^2.0.1",
    "html-webpack-plugin": "5.6.3",
    "identity-obj-proxy": "3.0.0",
    "is-wsl": "^3.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "2.2.2",
    "lint-staged": "^15.4.3",
    "mini-css-extract-plugin": "2.9.2",
    "next": "^15.1.7",
    "optimize-css-assets-webpack-plugin": "6.0.1",
    "pdfjs-dist": "3.11.174",
    "pnp-webpack-plugin": "1.7.0",
    "postcss": "^8.5.2",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-loader": "8.1.1",
    "postcss-normalize": "13.0.1",
    "postcss-preset-env": "^10.1.4",
    "postcss-safe-parser": "7.0.1",
    "prop-types": "^15.7.2",
    "react": "^19.0.0",
    "react-app-polyfill": "^3.0.0",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-ga": "^3.3.1",
    "react-modal": "^3.16.3",
    "react-top-loading-bar": "^3.0.2",
    "resolve": "1.22.10",
    "sass-loader": "^16.0.5",
    "smog-formula": "^2.0.1",
    "spache": "^2.0.1",
    "spache-formula": "^2.0.1",
    "style-loader": "4.0.0",
    "styled-components": "^6.1.15",
    "syllable": "^5.0.1",
    "tailwindcss": "^4.0.7",
    "terser-webpack-plugin": "5.3.11",
    "ts-pnp": "1.2.0",
    "unlerp": "^1.0.1",
    "url-loader": "4.1.1",
    "webpack": "5.98.0",
    "webpack-dev-server": "5.2.0",
    "webpack-manifest-plugin": "5.0.0",
    "workbox-webpack-plugin": "7.3.0",
    "worker-loader": "^3.0.8"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --single-quote --write",
      "git add"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js",
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$",
      "/node_modules/(?!(syllable|pluralize|dale-chall|dale-chall-formula|coleman-liau|smog-formula|gunning-fog|automated-readability|spache|spache-formula|compromise)/).+\\.js$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/draft-js": "^0.11.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-ga": "^2.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/syllable": "^5.0.2",
    "cssnano": "^7.0.6",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "canvas"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
